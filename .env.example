# Lead capture: this page POSTs to /api/lead, which forwards to your Zapier
# catch hook, which writes the row to Notion (and can fan out to Telegram etc).
#
# Zapier → Create Zap → Trigger "Webhooks by Zapier" → "Catch Hook" → copy URL.
# Then add it on Vercel: Project → Settings → Environment Variables.
#
# Payload keys sent (this is the contract — renaming one breaks the Zap):
#   lead_id (same on a retry of the same submission), name, first_name, last_name, email, phone, budget, purpose, comment,
#   source_section ("hero" | "closing"), source_label, summary, page_url,
#   submitted_at, and the ad it came from (empty when not from an ad):
#   utm_source, utm_medium, utm_campaign, utm_term, utm_content,
#   campaign_id, adset_id, ad_id, placement, fbclid
ZAPIER_WEBHOOK_URL=

# ── Meta Conversions API (server-side CompleteRegistration) ────────────────
# Events Manager → dataset 863938959764048 → Settings → Conversions API →
# "Generate access token". Server-only — set on Vercel, never NEXT_PUBLIC_.
# Leave empty to run with the browser pixel alone.
META_CAPI_TOKEN=
# Optional: a code from Events Manager → Test events, to see server events
# arrive live while testing. Remove it afterwards.
META_TEST_EVENT_CODE=

# ── Cloudflare R2: where the animation files live ──────────────────────────
# Dashboard → R2 → create a bucket, then:
#   1. Bucket → Settings → Custom Domains → connect e.g. data.ipanimations.ai
#      (this is the public, CDN-cached URL — NOT the r2.dev dev URL)
#   2. R2 → Manage API tokens → Create token, "Object Read & Write",
#      scoped to this one bucket. Copy the Access Key ID + Secret.
#
# Public (safe in the browser) — set in .env.local AND on Vercel:
NEXT_PUBLIC_MEDIA_BASE_URL=https://data.ipanimations.ai
# Secret (upload script only, .env.local on your machine — NOT needed on Vercel):
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
